---
import Ghost from './Ghost.astro';
---

<section class="relative px-4 pt-10 pb-20 sm:px-6">
  <div
    class="relative mx-auto flex max-w-6xl flex-col items-center justify-center overflow-hidden rounded-[48px] border border-white/10 bg-[#05041a] px-6 py-24 text-center sm:py-32 lg:py-44"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-[30%] -left-[15%] h-[420px] w-[420px] rounded-full opacity-25"
      style="background:#7c3aed;filter:blur(110px)"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-[15%] -bottom-[30%] h-[460px] w-[460px] rounded-full opacity-25"
      style="background:#06b6d4;filter:blur(110px)"
    >
    </div>

    <Ghost class="mx-auto mb-6 h-36 w-auto drop-shadow-[0_0_28px_rgba(34,211,238,0.45)] sm:h-44" />
    <h2 class="text-glow relative z-20 mb-4 max-w-[800px] text-balance text-3xl font-bold tracking-tight sm:text-5xl">
      Ready to make some magic?
    </h2>
    <p class="relative z-20 max-w-md font-sans text-base text-slate-400 sm:text-lg">
      Grab the APK, paste your first link, and watch it land in your gallery. Free forever.
    </p>
    <a
      href="/app/"
      class="relative z-20 mt-9 inline-flex items-center gap-2.5 rounded-full border border-primary/40 bg-[#22d3ee40] px-7 py-4 font-sans text-base font-semibold text-[#22d3ee] shadow-[0_0_10px_rgba(6,182,212,0.35),0_0_26px_rgba(6,182,212,0.3)] transition-all hover:scale-[1.03] hover:bg-[#22d3ee59] active:scale-95 active:opacity-90"
    >
      Download Phantom
    </a>
  </div>
</section>
