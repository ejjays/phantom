---
import { DOWNLOAD_URL } from '../content/site';
---

<footer class="border-t border-white/5 py-10">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 sm:px-6 md:flex-row md:justify-between"
  >
    <div class="flex items-center gap-3">
      <img src="/brand/icon.png" alt="" width="26" height="26" class="rounded-md" />
      <div>
        <p class="text-sm font-semibold">Phantom</p>
        <p class="font-mono text-[11px] text-slate-500">download · mux · save — fully on-device</p>
      </div>
    </div>

    <nav aria-label="Footer" class="flex items-center gap-6 text-xs text-slate-400">
      <a href="#features" class="transition-colors hover:text-cyan-300">Features</a>
      <a href="#screens" class="transition-colors hover:text-cyan-300">Screens</a>
      <a href="#how" class="transition-colors hover:text-cyan-300">How it works</a>
      <a href="#faq" class="transition-colors hover:text-cyan-300">FAQ</a>
      <a
        href={DOWNLOAD_URL}
        target="_blank"
        rel="noreferrer"
        class="transition-colors hover:text-cyan-300"
      >
        GitHub
      </a>
    </nav>
  </div>
  <p class="mt-8 text-center font-mono text-[11px] text-slate-600">
    © 2026 Phantom · not affiliated with any platform listed above
  </p>
</footer>
