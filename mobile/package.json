  "main": "index.ts",
  "scripts": {
    "start": "NODE_OPTIONS=\"--require ./userland-shim.cjs\" npx expo start --dev-client",
    "start:userland": "NODE_OPTIONS=\"--require ./userland-shim.cjs\" npx expo start --dev-client --offline",
