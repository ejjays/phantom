{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "monorepo:expo"],
  "minimumReleaseAge": "3 days",
  "timezone": "Etc/UTC",
  "schedule": ["before 6am on monday"],
  "separateMajorMinor": true,
  "packageRules": [
    {
      "description": "pinned at 1.0.1; patches/react-native-enriched-markdown+1.0.1.patch removes a long-press gesture conflict. a bump silently drops the patch (no ci signal — mobile ci doesn't build android).",
      "matchPackageNames": ["react-native-enriched-markdown"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major deps",
      "automerge": true
    },
    {
      "matchFileNames": ["mobile/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mobile non-major deps",
      "automerge": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "ignoreDeps": ["twrnc"]
}
