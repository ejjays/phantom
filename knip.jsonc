{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": ["dependencies", "unlisted", "unresolved", "binaries"],
  "ignoreBinaries": ["ffmpeg", "yt-dlp", "kaggle"],
  // web/site is an astro project; knip can't trace .astro entry points,
  // the runtime --require ./userland-shim.cjs (preview script) or the
  // postinstall scripts/binding-fix.mjs. Excluded intentionally rather
  // than maintained as a fragile half-config. Revisit if it stabilizes.
  "ignoreWorkspaces": ["web/site"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/extractors": {},
    "packages/web-mux": {},
    "web/backend": {
      "vite": false,
      "vitest": false,
      "ignoreDependencies": ["pino-pretty"]
    },
    "web/app": {
      "entry": ["src/main.tsx"],
      "vite": false,
      "vitest": false,
      "ignoreDependencies": [
        "@playwright/test",
        "@testing-library/jest-dom",
        "@types/styled-components",
        "@vitejs/plugin-react",
        "vite-plugin-sitemap"
      ]
    },
    "mobile": {
      "entry": [
        "tests/**/*.test.{ts,tsx}",
        "supabase/functions/**/index.ts",
        "plugins/*.js"
      ],
      "ignore": ["vitest.config.ts"],
      "ignoreDependencies": [
        "npm",
        "expo-dev-client",
        "expo-navigation-bar",
        "expo-status-bar",
        "expo-updates",
        "expo-blur",
        "expo-video"
      ],
      "vitest": false,
      "expo": false
    }
  }
}
