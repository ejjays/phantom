<div id="phantom-scene" class="relative mx-auto w-full max-w-[360px] select-none">
  <svg
    viewBox="0 0 400 430"
    width="360"
    height="387"
    class="block h-auto w-full"
    role="img"
    aria-label="Phantom mascot"
  >
    <defs>
      <linearGradient id="phantom-body" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="400" y2="430">
        <stop offset="0%" stop-color="#e0f7fa"></stop>
        <stop offset="60%" stop-color="#67e8f9"></stop>
        <stop offset="100%" stop-color="#06b6d4"></stop>
      </linearGradient>
    </defs>

    <ellipse id="hero-shadow" cx="200" cy="385" rx="75" ry="10" fill="#083344" opacity="0.2"></ellipse>

    <g id="phantom-float" style="filter: drop-shadow(0 8px 6px rgba(6, 182, 212, 0.3));">
      <path
        id="phantom-body"
        d="M 80 170 C 80 103.7, 133.7 50, 200 50 C 266.3 50, 320 103.7, 320 170 L 320 330 Q 290 352, 260 330 Q 230 352, 200 330 Q 170 352, 140 330 Q 110 352, 80 330 Z"
        fill="url(#phantom-body)"
      ></path>
      <path
        d="M 285 105 C 305 140, 320 220, 320 330 Q 290 352, 260 330 Q 250 322, 245 310 C 270 270, 280 180, 285 105 Z"
        fill="#0891b2"
        opacity="0.4"
      ></path>

      <g id="sweat" opacity="0">
        <g transform="translate(96 66) scale(0.75)">
          <path
            d="M28,19c0,6.62-5.38,12-12,12S4,25.62,4,19C4,12.58,14.83,1.75,15.3,1.29c0.39-0.39,1.01-0.39,1.4,0C17.17,1.75,28,12.58,28,19z"
            fill="#34b0c0"
          ></path>
          <path
            d="M14,26c-3.3086,0-6-2.6914-6-6c0-0.5527,0.4478-1,1-1s1,0.4473,1,1c0,2.2061,1.7944,4,4,4c0.5522,0,1,0.4473,1,1S14.5522,26,14,26z"
            fill="#ffffff"
          ></path>
        </g>
      </g>

      <g id="phantom-face">
        <g id="eyes">
          <ellipse cx="165" cy="180" rx="13" ry="18" fill="#083344"></ellipse>
          <ellipse cx="235" cy="180" rx="13" ry="18" fill="#083344"></ellipse>
          <ellipse class="pupil" cx="168" cy="175" rx="5" ry="7" fill="#ffffff"></ellipse>
          <ellipse class="pupil" cx="238" cy="175" rx="5" ry="7" fill="#ffffff"></ellipse>
        </g>
        <ellipse cx="148" cy="197" rx="9" ry="5" fill="#0891b2" opacity="0.6"></ellipse>
        <ellipse cx="252" cy="197" rx="9" ry="5" fill="#0891b2" opacity="0.6"></ellipse>
        <g id="mouth-breathe">
          <path id="phantom-mouth" d="" fill="#083344"></path>
        </g>
      </g>

      <path
        id="phantom-hit"
        d="M 80 170 C 80 103.7, 133.7 50, 200 50 C 266.3 50, 320 103.7, 320 170 L 320 330 Q 290 352, 260 330 Q 230 352, 200 330 Q 170 352, 140 330 Q 110 352, 80 330 Z"
        fill="transparent"
      ></path>
    </g>
  </svg>
</div>

<script>
  import { gsap } from 'gsap';

  const NEUTRAL = [187, 218, 195.67, 222.67, 204.33, 222.67, 213, 218, 204.33, 218.67, 195.67, 218.67, 187, 218];
  const SMILE = [186, 213, 195.33, 229, 204.67, 229, 214, 213, 204.67, 209, 195.33, 209, 186, 213];

  const scene = document.getElementById('phantom-scene');
  if (scene) {
    const mouthEl = document.getElementById('phantom-mouth');
    const drawMouth = (t: number) => {
      if (!mouthEl) return;
      const cur = NEUTRAL.map((v, i) => v + (SMILE[i] - v) * t);
      mouthEl.setAttribute(
        'd',
        `M ${cur[0]} ${cur[1]} C ${cur[2]} ${cur[3]}, ${cur[4]} ${cur[5]}, ${cur[6]} ${cur[7]} C ${cur[8]} ${cur[9]}, ${cur[10]} ${cur[11]}, ${cur[12]} ${cur[13]} Z`
      );
    };

    const mood = { t: 0 };
    drawMouth(0);
    let idleMouth: gsap.core.Timeline | null = null;
    let pressed = false;
    let pressTweens: gsap.core.Tween[] = [];
    let sweatTween: gsap.core.Tween | null = null;

    const ctx = gsap.context(() => {
      gsap.to('#phantom-float', {
        y: -15,
        duration: 1.6,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });
      gsap.to('#hero-shadow', {
        scaleX: 0.82,
        opacity: 0.1,
        svgOrigin: '200 385',
        duration: 1.6,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });
      gsap
        .timeline({ repeat: -1, delay: 10 })
        .to('#eyes', { scaleY: 0.1, svgOrigin: '200 180', duration: 0.168 })
        .to('#eyes', { scaleY: 1, duration: 0.168 });
      gsap.to('#mouth-breathe', {
        scaleX: 1.04,
        scaleY: 0.96,
        svgOrigin: '200 220',
        duration: 1.6,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });
      idleMouth = gsap
        .timeline({ repeat: -1, delay: 2, repeatDelay: 1 })
        .to(mood, { t: 1, duration: 0.3, ease: 'power1.inOut' })
        .to(mood, { t: 0, duration: 0.3, delay: 10, ease: 'power1.inOut' })
        .to(mood, { t: 1, duration: 0.3, ease: 'power1.inOut' });
      idleMouth.eventCallback('onUpdate', () => drawMouth(mood.t));

    scene.addEventListener('pointerenter', () => {
      if (pressed) return;
      gsap.to('#phantom-face', { y: 16, duration: 0.4, ease: 'power2.out' });
      gsap.to('.pupil', { y: 4.8, duration: 0.4, ease: 'power2.out' });
    });
    scene.addEventListener('pointerleave', () => {
      if (!pressed) {
        gsap.to('#phantom-face', { y: 0, duration: 0.4, ease: 'power2.inOut' });
        gsap.to('.pupil', { y: 0, duration: 0.4, ease: 'power2.inOut' });
      }
    });

    const hit = document.getElementById('phantom-hit');

    hit?.addEventListener('pointerdown', () => {
      if (pressed) return;
      pressed = true;
      idleMouth?.kill();
      gsap.to('#phantom-face', { y: 0, duration: 0.3 });
      gsap.to('.pupil', { y: 0, duration: 0.3 });
      const burst = gsap.timeline({ repeat: -1 });
      burst
        .to('#eyes', { scaleY: 0.1, svgOrigin: '200 180', duration: 0.1, delay: 0.5 })
        .to('#eyes', { scaleY: 1, duration: 0.168 })
        .to('#eyes', { scaleY: 0.1, duration: 0.168 })
        .to('#eyes', { scaleY: 1, duration: 0.168, delay: 1.332 });
      const giggle = gsap.timeline({ repeat: -1, delay: 0.5, onRepeat: () => drawMouth(mood.t) });
      giggle
        .to(mood, { t: 0.7, duration: 0.084 })
        .to(mood, { t: 0.85, duration: 0.084 })
        .to(mood, { t: 0.7, duration: 0.084 })
        .to(mood, { t: 0.85, duration: 0.084 });
      giggle.eventCallback('onUpdate', () => drawMouth(mood.t));
      sweatTween = gsap.to('#sweat', {
        opacity: 1,
        y: 14,
        duration: 0.5,
        ease: 'power1.inOut',
        delay: 4,
        repeat: -1,
        repeatDelay: 3.1,
        yoyo: true,
      });
      pressTweens = [burst, giggle];
      gsap.delayedCall(12, () => {
        if (pressed) relax();
      });
    });

    function relax() {
      if (!pressed) return;
      pressed = false;
      pressTweens.forEach((tw) => tw.kill());
      pressTweens = [];
      sweatTween?.kill();
      gsap.to('#sweat', { opacity: 0, y: 0, duration: 0.15, delay: 2.18 });
      gsap.to('#eyes', { scaleY: 1, svgOrigin: '200 180', duration: 0.15 });
      gsap.delayedCall(1, () => {
        if (!pressed && !idleMouth?.isActive()) {
          idleMouth = gsap
            .timeline({ repeat: -1, repeatDelay: 1 })
            .to(mood, { t: 1, duration: 0.3, ease: 'power1.inOut' })
            .to(mood, { t: 0, duration: 0.3, delay: 10, ease: 'power1.inOut' })
            .to(mood, { t: 1, duration: 0.3, ease: 'power1.inOut' });
          idleMouth.eventCallback('onUpdate', () => drawMouth(mood.t));
        }
      });
    }

    scene.addEventListener('pointerup', () => relax());
    scene.addEventListener('pointercancel', () => relax());
    scene.addEventListener('pointerleave', () => {
      if (pressed) gsap.delayedCall(0.2, () => relax());
    });

    window.addEventListener(
      'pagehide',
      () => {
        ctx.revert();
      },
      { once: true }
    );
  }
</script>
