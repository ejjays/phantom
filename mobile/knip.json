{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "App.tsx",
    "tests/**/*.test.{ts,tsx}",
    "supabase/functions/**/index.ts",
    "plugins/*.js"
  ],
  "project": ["**/*.{ts,tsx,js}", "!**/*.d.ts"],
  "ignore": ["vitest.config.ts"],
  "ignoreDependencies": [
    "npm",
    "expo-asset",
    "expo-dev-client",
    "expo-navigation-bar",
    "expo-sharing",
    "expo-status-bar",
    "expo-updates"
  ],
  "vitest": false,
  "expo": false
}
