# Reference: docs/env-variables.md
# All optional — each enables a feature.


# AI query synthesis fallback
GEMINI_API_KEY=
GROQ_API_KEY=

# Data layer
REDIS_URL=redis://127.0.0.1:6379
TURSO_URL=
TURSO_AUTH_TOKEN=

# ISRC metadata fallback
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=
ACOUSTID_API_KEY=


# Observability
SENTRY_DSN=

# Core
# PORT=5000
# LOG_LEVEL=info
API_ONLY=false

# Alternative to GEMINI_API_KEY
VERTEX_API_KEY=


# Remix Lab Kaggle sync
KAGGLE_USERNAME=
KAGGLE_KEY=

# Public instance hardening (see docs/protect-an-instance.md)
AUTH_MODE=
API_KEY=
ALLOWED_ORIGINS=
PROXY_SIGNING_SECRET=
PROXY_URL_TTL_SECONDS=
PROXY_ALLOW_INSECURE_TLS=
