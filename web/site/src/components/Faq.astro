---
import { FAQS } from '../content/site';
---

<section id="faq" class="relative py-14 sm:py-20">
  <div class="mx-auto mb-10 max-w-2xl text-center">
    <p class="mb-3 text-xs tracking-[0.25em] text-cyan-400 uppercase">{'// faq'}</p>
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Fair questions</h2>
  </div>
  <div class="mx-auto max-w-3xl space-y-3 px-4 sm:px-6">
    {
      FAQS.map((faq, index) => (
        <details
          class="group overflow-hidden rounded-2xl border border-white/8 bg-surface/50 transition-colors hover:border-white/15 open:border-cyan-400/25 open:bg-surface"
          open={index === 0}
        >
          <summary class="flex w-full cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-left [&::-webkit-details-marker]:hidden">
            <span class="text-sm font-semibold sm:text-base">{faq.question}</span>
            <span
              class="shrink-0 text-cyan-400 transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="px-6 pb-5 font-sans text-sm leading-relaxed text-slate-400">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</section>
