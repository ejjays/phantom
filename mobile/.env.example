# Reference: docs/env-variables.md
# All optional — each enables a feature.
# All EXPO_PUBLIC_* vars are bundled into the APK (public). Never ship secrets.

# Sentry crash reporting
EXPO_PUBLIC_SENTRY_DSN=

# Updates tab (Supabase)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Native Google sign-in (Web OAuth client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Edge registry (read-only token required)
EXPO_PUBLIC_TURSO_URL=
EXPO_PUBLIC_TURSO_READ_TOKEN=

# Giphy GIF picker in comments
EXPO_PUBLIC_GIPHY_KEY=

# Bypass in-memory resolve cache
EXPO_PUBLIC_DISABLE_FAST_RESOLVE=

# Enable ffmpeg fallback when the pure-TS mux core refuses (webm input)
EXPO_PUBLIC_FFMPEG_FALLBACK=

# Personal cookies — NEVER ship in public builds
EXPO_PUBLIC_BILIBILI_COOKIE=
EXPO_PUBLIC_IG_COOKIE=

# Spotify: configured server-side via Supabase edge function
# supabase secrets set SPOTIFY_CLIENT_ID=xxx SPOTIFY_CLIENT_SECRET=yyy
# supabase functions deploy spotify-token

# Support tips: PayMongo hosted checkout — secret keys never belong in
# EXPO_PUBLIC_ vars. See edge function headers for full setup.
# supabase secrets set PAYMONGO_SECRET_KEY=sk_test_...
# supabase secrets set PAYMONGO_WEBHOOK_SIG=whsk_...
# supabase functions deploy paymongo-checkout
# supabase functions deploy paymongo-webhook --no-verify-jwt
